{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/user-service/Dockerfile",
    "watchPatterns": [
      "services/user-service/**",
      "packages/config/**",
      "packages/utils/**",
      "pnpm-lock.yaml",
      "package.json",
      "pnpm-workspace.yaml"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
