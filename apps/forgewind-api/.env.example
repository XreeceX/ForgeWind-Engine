# forgewind-api — Railway / local environment
# Copy relevant lines to Railway Variables.

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Shared with user-service — must match exactly.
JWT_SECRET=change-me-in-production-minimum-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-32-ch
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# URL of the user-service (Railway reference variable or public domain)
USER_SERVICE_URL=https://your-user-service.up.railway.app

JOB_SERVICE_URL=

# CORS — set to your Vercel app URL(s), comma-separated if multiple.
CORS_ORIGIN=https://your-app.vercel.app

# GitHub API (optional — improves rate limits for repo sync)
GITHUB_TOKEN=

# AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

PORT=3001
NODE_ENV=production
