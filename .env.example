# ============================================
# ForgeWind Engine — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# Never commit a .env file with real secrets.

# --- General ---
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL) ---
# Neon pooled example: postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# forgewind-api (Drizzle): use the URL as-is (public schema).
# user-service (Prisma): append &schema=user_service to the same Neon DB.
DATABASE_URL=postgresql://forgewind:forgewind_dev@localhost:5432/forgewind

# --- Auth (backend services) ---
# Both JWT secrets must be at least 32 characters and must match across services.
JWT_SECRET=change-me-in-production-minimum-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-32-ch
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Auth (Next.js web app) ---
# Must be at least 32 characters. Use: openssl rand -base64 32
AUTH_SECRET=change-me-nextauth-secret-minimum-32-chars
# Your deployed URL — no trailing slash. Must match the Vercel/Railway domain exactly.
NEXTAUTH_URL=http://localhost:3000
USER_SERVICE_URL=http://localhost:4001
JOB_SERVICE_URL=http://localhost:4004

# --- OAuth Providers ---
# Google: https://console.developers.google.com/
# Authorised redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn: https://www.linkedin.com/developers/apps
# Authorised redirect URI: {NEXTAUTH_URL}/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- AI / LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- GitHub Integration ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4010/api/v1/github/callback
GITHUB_TOKEN=
GITHUB_TOKEN_ENCRYPTION_KEY=

# --- Apps / Web (Next.js) ---
# Base URL of forgewind-api — no trailing slash, no /api suffix.
NEXT_PUBLIC_FORGEWIND_API_URL=http://localhost:3001
NEXT_PUBLIC_USER_SERVICE_URL=http://localhost:4001

# --- Vector DB (Pinecone) ---
PINECONE_API_KEY=
PINECONE_INDEX=forgewind

# --- Object Storage (S3-compatible) ---
S3_BUCKET=forgewind-uploads
S3_REGION=eu-west-2
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Observability ---
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Deployment notes
# ---------------------------------------------------------------------------
# Database schemas
#   Apply Drizzle schema to Neon (forgewind-api): pnpm db:forgewind:migrate
#   Apply Prisma schema (user-service):  DATABASE_URL='...&schema=user_service' pnpm db:user-service:push
#
# Railway (2 backend services: forgewind-api + user-service)
#   See railway.env.example for the complete Railway variable reference.
#
# Vercel (apps/web)
#   Required: AUTH_SECRET, NEXTAUTH_URL, NEXT_PUBLIC_FORGEWIND_API_URL,
#             NEXT_PUBLIC_USER_SERVICE_URL, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
#             LINKEDIN_CLIENT_ID, LINKEDIN_CLIENT_SECRET
#   Redeploy after any env var change.
