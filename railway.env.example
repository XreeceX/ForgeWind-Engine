# Railway setup — ForgeWind Engine (2 backend services)
# Frontend is deployed on Vercel (apps/web). Railway runs forgewind-api + user-service only.
#
# --- Deployment steps ---
#
# 1. Push latest code: git push origin master
#
# 2. Fix the existing "ForgeWind-Engine" service → forgewind-api
#    Settings → General: rename to "forgewind-api"
#    Settings → Source: Root Directory = / (repo root)
#    Config-as-code: apps/forgewind-api/railway.json is auto-detected
#    Settings → Networking → Generate Domain
#    Variables → add forgewind-api vars below
#    Deployments → Redeploy
#
# 3. Add user-service
#    Project canvas → + New → GitHub Repo → same repo
#    Rename to "user-service"
#    Config-as-code → Railway config file: services/user-service/railway.json
#    Root Directory = /
#    Generate Domain + add user-service vars below
#
# 4. Link services
#    On forgewind-api, set:
#      USER_SERVICE_URL = ${{user-service.RAILWAY_PUBLIC_DOMAIN}} (Railway reference variable)
#
# 5. Vercel env
#    NEXT_PUBLIC_FORGEWIND_API_URL = https://<forgewind-api public domain>
#    NEXT_PUBLIC_USER_SERVICE_URL  = https://<user-service public domain>
#    AUTH_SECRET = <32+ char secret>
#    NEXTAUTH_URL = https://<your-vercel-domain>.vercel.app
#    GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
#    LINKEDIN_CLIENT_ID, LINKEDIN_CLIENT_SECRET
#    Redeploy Vercel after setting vars.

# --- Shared (set on BOTH services) ---
NODE_ENV=production
JWT_SECRET=forgewind-prod-jwt-secret-minimum-32-chars
JWT_REFRESH_SECRET=forgewind-prod-refresh-secret-min-32-ch
CORS_ORIGIN=https://YOUR-APP.vercel.app
HUSKY=0

# --- forgewind-api only ---
# DATABASE_URL=postgresql://USER:PASS@ep-xxx.neon.tech/neondb?sslmode=require
# USER_SERVICE_URL=https://your-user-service.up.railway.app

# --- user-service only ---
# DATABASE_URL=postgresql://USER:PASS@ep-xxx.neon.tech/neondb?sslmode=require&schema=user_service
