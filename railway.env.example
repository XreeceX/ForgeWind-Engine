# Railway setup — ForgeWind Engine (2 backend services)
# Frontend stays on Vercel (apps/web). Railway runs forgewind-api + user-service only.
#
# WHY ONLY 1 SERVICE?
# Connecting a repo to one service creates ONE service. You must add the second manually
# (or create a brand-new project from GitHub after pushing the latest master).
#
# --- Step 1: Push latest code ---
# git push origin master
# (Needs commit with railway.json + only 2 packages having "start" scripts)
#
# --- Step 2: Fix the existing "ForgeWind-Engine" service → forgewind-api ---
# Settings → General: rename service to "forgewind-api"
# Settings → Source: Root Directory = / (leave empty / repo root)
# Settings → Config-as-code → Railway config file: apps/forgewind-api/railway.json
# Settings → Networking → Generate Domain
# Settings → Variables: add shared + forgewind-api vars below
# Deployments → Redeploy
#
# --- Step 3: Add user-service ---
# Project canvas → + New → GitHub Repo → XreeceX/ForgeWind-Engine (same repo)
# Rename service to "user-service"
# Config-as-code → Railway config file: services/user-service/railway.json
# Root Directory = / (empty)
# Generate Domain + add user-service variables below
#
# --- Step 4: Link services ---
# On forgewind-api, set:
#   USER_SERVICE_URL=https://${{user-service.RAILWAY_PUBLIC_DOMAIN}}
# (Use Railway reference variable picker in the Variables tab)
#
# --- Step 5: Vercel env ---
# NEXT_PUBLIC_FORGEWIND_API_URL=https://<forgewind-api domain>
# NEXT_PUBLIC_USER_SERVICE_URL=https://<user-service domain>

# --- Shared (set on BOTH services) ---
NODE_ENV=production
JWT_SECRET=forgewind-prod-jwt-secret-minimum-32-chars
JWT_REFRESH_SECRET=forgewind-prod-refresh-secret-min-32-ch
CORS_ORIGIN=https://YOUR-APP.vercel.app
HUSKY=0

# --- forgewind-api only ---
# DATABASE_URL=postgresql://USER:PASS@ep-xxx.neon.tech/neondb?sslmode=require
# USER_SERVICE_URL=https://${{user-service.RAILWAY_PUBLIC_DOMAIN}}

# --- user-service only ---
# DATABASE_URL=postgresql://USER:PASS@ep-xxx.neon.tech/neondb?sslmode=require&schema=user_service
